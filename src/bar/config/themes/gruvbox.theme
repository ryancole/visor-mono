; Gruvbox for Visor: a Windows theme (wallpaper, mode, accent) after Gruvbox, dark medium (https://github.com/morhetz/gruvbox, MIT).
; The wallpaper path is relative to this file (Visor's addition; Windows wants an
; absolute one, so Visor installs an absolute-path copy when applying it).
; gruvbox.terminal.json next to it is the matching Windows Terminal scheme.

[Theme]
DisplayName=Gruvbox

[Control Panel\Desktop]
Wallpaper=gruvbox.png
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
ColorizationColor=0XC4FABD2F
SystemMode=Dark
AppMode=Dark

[MasterThemeSelector]
MTSM=DABJDKT
