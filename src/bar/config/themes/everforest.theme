; Everforest for Visor: a Windows theme (wallpaper, mode, accent) after Everforest, dark medium (https://github.com/sainnhe/everforest, MIT).
; The wallpaper path is relative to this file (Visor's addition; Windows wants an
; absolute one, so Visor installs an absolute-path copy when applying it).
; everforest.terminal.json next to it is the matching Windows Terminal scheme.

[Theme]
DisplayName=Everforest

[Control Panel\Desktop]
Wallpaper=everforest.png
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
ColorizationColor=0XC4A7C080
SystemMode=Dark
AppMode=Dark

[MasterThemeSelector]
MTSM=DABJDKT
