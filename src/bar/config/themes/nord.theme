; Nord for Visor: a Windows theme (wallpaper, mode, accent) after Nord (https://github.com/nordtheme/nord, MIT).
; The wallpaper path is relative to this file (Visor's addition; Windows wants an
; absolute one, so Visor installs an absolute-path copy when applying it).
; nord.terminal.json next to it is the matching Windows Terminal scheme.

[Theme]
DisplayName=Nord

[Control Panel\Desktop]
Wallpaper=nord.png
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
ColorizationColor=0XC488C0D0
SystemMode=Dark
AppMode=Dark

[MasterThemeSelector]
MTSM=DABJDKT
